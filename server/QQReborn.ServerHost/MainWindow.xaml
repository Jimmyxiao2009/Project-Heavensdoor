<Window x:Class="QQReborn.ServerHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ Reborn 管家"
        Width="940" Height="720"
        MinWidth="740" MinHeight="540"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="QQ REBORN GATEWAY" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock Text="QQ Reborn 管家" Foreground="{StaticResource Text}" FontSize="28" FontWeight="Light" Margin="0,2,0,0"/>
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="RepoRootText" Foreground="{StaticResource Muted}" FontSize="11"
                 VerticalAlignment="Bottom" TextAlignment="Right" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
    </Grid>

    <!-- Status cards + actions -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="QQ 网关" Foreground="{StaticResource Muted}" FontSize="12"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Ellipse x:Name="RealDot" Width="10" Height="10" Fill="{StaticResource Bad}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="RealStatus" Text="已停止" Foreground="{StaticResource Text}" FontSize="16"/>
          </StackPanel>
          <TextBlock x:Name="RealUrl" Text="ws://127.0.0.1:8765/ws" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,8,0,0"
                     Cursor="Hand" MouseLeftButtonUp="RealUrl_Click" ToolTip="点击复制"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="NapCat / NTQQ" Foreground="{StaticResource Muted}" FontSize="12"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Ellipse x:Name="NapCatDot" Width="10" Height="10" Fill="{StaticResource Bad}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="NapCatStatus" Text="未检测" Foreground="{StaticResource Text}" FontSize="16"/>
          </StackPanel>
          <TextBlock x:Name="NapCatUrl" Text="http://127.0.0.1:3000/get_login_info" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,8,0,0"
                     Cursor="Hand" MouseLeftButtonUp="NapCatUrl_Click" ToolTip="点击复制"/>

          <TextBlock Text="登录账号" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/>
          <ComboBox x:Name="AccountCombo"
                    IsEditable="False"
                    Padding="6,4"
                    DisplayMemberPath="Display"
                    SelectionChanged="AccountCombo_SelectionChanged"
                    ToolTip="选择要用 NapCat 快速登录的 QQ 号"/>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="自定义 QQ 号" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
              <TextBox x:Name="CustomUinBox" Padding="6,4"
                       ToolTip="输入其它 QQ 号后点「加入列表」"
                       PreviewKeyDown="CustomUinBox_PreviewKeyDown"/>
            </StackPanel>
            <Button Grid.Column="1" Content="加入列表" Click="AddAccount_Click"
                    VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="10,6"
                    Background="#FF2A2A2A" Foreground="{StaticResource Text}" BorderThickness="0" Cursor="Hand"/>
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2" MinWidth="220">
        <TextBlock Text="访问密码" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="复制" Click="CopyPassword_Click" Padding="8,6" Margin="6,0,0,0"/>
          <TextBox x:Name="AccessPasswordBox" Padding="8,6"/>
        </DockPanel>
        <Button x:Name="StartAllBtn" Content="▶  启动网关" Click="StartAll_Click"
                Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                Padding="12,10" Margin="0,0,0,6" FontSize="14" Cursor="Hand"/>
        <Button x:Name="StopAllBtn" Content="■  停止网关" Click="StopAll_Click"
                Background="#FF333333" Foreground="White" BorderThickness="0"
                Padding="12,10" Margin="0,0,0,6" FontSize="14" Cursor="Hand"/>
        <Button x:Name="StartNapCatBtn" Content="启动 NapCat" Click="StartNapCat_Click"
                Background="#FF2A2A2A" Foreground="{StaticResource Text}" BorderThickness="0"
                Padding="12,8" Margin="0,0,0,6" FontSize="13" Cursor="Hand"/>
        <Button Content="检测 NapCat" Click="CheckNapCat_Click"
                Background="#FF2A2A2A" Foreground="{StaticResource Text}" BorderThickness="0"
                Padding="12,8" Margin="0,0,0,6" FontSize="13" Cursor="Hand"/>
        <Button Content="写入 OneBot 配置" Click="EnsureConfig_Click"
                Background="#FF2A2A2A" Foreground="{StaticResource Text}" BorderThickness="0"
                Padding="12,8" Margin="0,0,0,6" FontSize="13" Cursor="Hand"
                ToolTip="确保 HTTP 3000 / 事件 WS 3001（仅本机）"/>
        <Button Content="复制访问地址" Click="CopyAddress_Click"
                Background="#FF2A2A2A" Foreground="{StaticResource Text}" BorderThickness="0"
                Padding="12,8" FontSize="13" Cursor="Hand"/>
      </StackPanel>
    </Grid>

    <!-- Log -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="6" Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="4,2,4,6">
          <TextBlock Text="日志" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          <Button Content="清空" HorizontalAlignment="Right" Click="ClearLog_Click"
                  Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Background="#FF111111" Foreground="#FFCCCCCC" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12" Padding="6"/>
      </DockPanel>
    </Border>

    <!-- Footer tips -->
    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
               Text="先选登录账号再启动 NapCat。默认大号 1913695019。首次会同步到 %LocalAppData%\QQReborn\NapCat 并写入 OneBot 3000/3001。出门只映射 8765。"/>
  </Grid>
</Window>
