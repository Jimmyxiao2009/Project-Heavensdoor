<Window x:Class="QQReborn.ServerHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QQ Reborn · Server Host"
        Width="920" Height="640"
        MinWidth="720" MinHeight="480"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="QQ REBORN SERVER" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock Text="控制面板" Foreground="{StaticResource Text}" FontSize="28" FontWeight="Light" Margin="0,2,0,0"/>
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="RepoRootText" Foreground="{StaticResource Muted}" FontSize="11"
                 VerticalAlignment="Bottom" TextAlignment="Right" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
    </Grid>

    <!-- Status cards + actions -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="RealServer" Foreground="{StaticResource Muted}" FontSize="12"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Ellipse x:Name="RealDot" Width="10" Height="10" Fill="{StaticResource Bad}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="RealStatus" Text="已停止" Foreground="{StaticResource Text}" FontSize="16"/>
          </StackPanel>
          <TextBlock x:Name="RealUrl" Text="ws://127.0.0.1:8765/ws" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,8,0,0"
                     Cursor="Hand" MouseLeftButtonUp="RealUrl_Click" ToolTip="点击复制"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="LocalSignProxy" Foreground="{StaticResource Muted}" FontSize="12"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Ellipse x:Name="SignDot" Width="10" Height="10" Fill="{StaticResource Bad}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SignStatus" Text="已停止" Foreground="{StaticResource Text}" FontSize="16"/>
          </StackPanel>
          <TextBlock x:Name="SignUrl" Text="http://127.0.0.1:18488" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,8,0,0"
                     Cursor="Hand" MouseLeftButtonUp="SignUrl_Click" ToolTip="点击复制"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2" MinWidth="180">
        <TextBlock Text="后端协议" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <ComboBox x:Name="BackendCombo" SelectedIndex="0" Margin="0,0,0,8" Padding="8,6"
                  ToolTip="Lagrange=现有签名桥；NapCat=OneBot/NTQQ">
          <ComboBoxItem Content="Lagrange (默认)" Tag="lagrange"/>
          <ComboBoxItem Content="NapCat (OneBot)" Tag="napcat"/>
        </ComboBox>
        <Button x:Name="StartAllBtn" Content="▶  全部启动" Click="StartAll_Click"
                Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                Padding="12,10" Margin="0,0,0,6" FontSize="14" Cursor="Hand"/>
        <Button x:Name="StopAllBtn" Content="■  全部停止" Click="StopAll_Click"
                Background="#FF333333" Foreground="White" BorderThickness="0"
                Padding="12,10" Margin="0,0,0,6" FontSize="14" Cursor="Hand"/>
        <Button Content="空间 Webhook 自测" Click="WebhookTest_Click"
                Background="#FF2A2A2A" Foreground="{StaticResource Text}" BorderThickness="0"
                Padding="12,10" Margin="0,0,0,6" FontSize="13" Cursor="Hand"/>
        <Button Content="打开 Webhook 说明" Click="WebhookHelp_Click"
                Background="#FF2A2A2A" Foreground="{StaticResource Muted}" BorderThickness="0"
                Padding="12,8" FontSize="12" Cursor="Hand"/>
      </StackPanel>
    </Grid>

    <!-- Log -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="6" Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="4,2,4,6">
          <TextBlock Text="日志" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          <Button Content="清空" HorizontalAlignment="Right" Click="ClearLog_Click"
                  Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Background="#FF111111" Foreground="#FFCCCCCC" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12" Padding="6"/>
      </DockPanel>
    </Border>

    <!-- Footer tips -->
    <TextBlock Grid.Row="3" Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
               Text="App 设置：签名服务器 http://127.0.0.1:18488 · WS 指向本机 :8765/ws · 空间动态由 POST /webhook/space 注入"/>
  </Grid>
</Window>
