<Page
    x:Class="QQReborn.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="设置" Style="{StaticResource ModernHeaderTitleStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Margin="14,10,14,28">

                <TextBlock Text="通用" Style="{StaticResource MetroSectionLabelStyle}" Margin="8,4,0,8" />
                <Border Style="{StaticResource ModernSettingsCardStyle}">
                    <StackPanel>
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="深色模式" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="深色壳 · 暂不可关闭" FontSize="12"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding DarkMode}" IsEnabled="False"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="消息通知" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="接收新消息提醒" FontSize="12"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding Notifications, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="输入时回车发送" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="关闭后回车换行，按发送键发送" FontSize="12"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding EnterToSend, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="界面大小" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="调整字号与列表密度" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding FontSizeText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="0" Maximum="2" StepFrequency="1"
                                TickFrequency="1" TickPlacement="Outside"
                                Value="{Binding FontSizeLevel, Mode=TwoWay}"
                                Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,2" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="小" FontSize="11" HorizontalAlignment="Left"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="标准" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="大" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="实用功能" Style="{StaticResource MetroSectionLabelStyle}" Margin="8,8,0,8" />
                <Border Style="{StaticResource ModernSettingsCardStyle}">
                    <StackPanel>
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="防撤回" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="对方撤回后本地仍可见原文" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding AntiRecall, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="显示撤回提示" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="有人撤回时在会话里插一条提示" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding ShowRevokeNotice, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="双击戳一戳" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="双击对方气泡发送戳一戳" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding DoubleTapNudge, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="发送前确认" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="点发送时再确认一次，防误触" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding ConfirmBeforeSend, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="复制带发送者" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="多选复制时每行前加昵称" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding CopyWithSender, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="来消息震动" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="新消息时手机震动（需开启消息通知）" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding VibrateOnMessage, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="聊天里：长按消息 → 多选 / 复制 / 转发 / 截图选中"
                           FontSize="12" TextWrapping="Wrap" Margin="8,0,8,4"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />

                <TextBlock Text="网关连接" Style="{StaticResource MetroSectionLabelStyle}" Margin="8,8,0,8" />
                <Border Style="{StaticResource ModernSettingsCardStyle}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="服务器地址" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="本机 localhost；同 WiFi 填电脑局域网 IP；出门填 Frp 访问主机"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,8" />
                        <TextBox Text="{Binding ServerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="localhost" InputScope="Url" />

                        <TextBlock Text="服务器端口" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="默认 8765；若 Frp 远程端口不是 8765，改成面板上的远程端口"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,8" />
                        <TextBox Text="{Binding ServerPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="8765" InputScope="Number" />

                        <TextBlock Text="网关访问密码" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="这是电脑管家的访问口令，不是 QQ 密码"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,8" />
                        <PasswordBox x:Name="AccessPasswordBox" PasswordChanged="AccessPasswordBox_PasswordChanged"
                                     PlaceholderText="填写管家显示的访问密码" />

                        <Button Content="连接网关" Click="LoginButton_Click"
                                Style="{StaticResource MetroAccentButtonStyle}" Margin="0,14,0,4" />
                        <TextBlock Text="号在电脑上的 NapCat/NTQQ 已登录；此处只需地址、端口、密码即可进会话。"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="存储" Style="{StaticResource MetroSectionLabelStyle}" Margin="8,8,0,8" />
                <Border Style="{StaticResource ModernSettingsCardStyle}">
                    <StackPanel>
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="清除缓存" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="{Binding CacheStatus}" FontSize="12"
                                           Foreground="{StaticResource MetroAccentBrush}" Margin="0,3,0,0"
                                           Visibility="{Binding HasCacheStatus, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ClearCacheButton" Content="清除" Click="ClearCacheButton_Click"
                                    Style="{StaticResource MetroChromeButtonStyle}" Padding="16,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" />
                        <Grid MinHeight="58" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="文件下载目录" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="{Binding DownloadFolderPath}" FontSize="12"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="PickDownloadFolderButton" Content="选择" Click="PickDownloadFolder_Click"
                                    Style="{StaticResource MetroChromeButtonStyle}" Padding="16,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="关于" Style="{StaticResource MetroSectionLabelStyle}" Margin="8,8,0,8" />
                <Border Style="{StaticResource ModernSettingsCardStyle}" Padding="14,14">
                    <StackPanel>
                        <TextBlock Text="关于 QQ Reborn" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="{Binding VersionText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
