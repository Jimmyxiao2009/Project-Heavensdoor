<Page
    x:Class="QQReborn.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- WP-style hero title -->
        <Grid Grid.Row="0" Margin="19,10,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="我" Style="{StaticResource MetroPageTitleStyle}" />
                <TextBlock Text="设置" Style="{StaticResource MetroHeroTitleStyle}" Margin="0,-2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="&#x2190;" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Margin="24,8,24,24">

                <TextBlock Text="通用" Style="{StaticResource MetroSectionLabelStyle}" Margin="0,4,0,8" />

                <!-- 深色模式 (read-only on) -->
                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="深色模式" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="METRO 黑 · 暂不可关闭" FontSize="12"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding DarkMode}" IsEnabled="False"
                                  VerticalAlignment="Center" />
                </Grid>

                <!-- 消息通知 -->
                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="消息通知" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="接收新消息提醒" FontSize="12"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding Notifications, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </Grid>

                <!-- 输入时回车发送 -->
                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="输入时回车发送" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="关闭后回车换行，按发送键发送" FontSize="12"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding EnterToSend, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </Grid>

                <!-- 字体大小 -->
                <Grid Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="字体大小" FontSize="20" FontWeight="Light"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding FontSizeText}" FontSize="14"
                               Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="0" Maximum="2" StepFrequency="1"
                        TickFrequency="1" TickPlacement="Outside"
                        Value="{Binding FontSizeLevel, Mode=TwoWay}"
                        Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="小" FontSize="12" HorizontalAlignment="Left"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" Text="标准" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    <TextBlock Grid.Column="2" Text="大" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                </Grid>

                <Border Height="1" Background="{StaticResource MetroSubtleBrush}" Margin="0,12,0,12" />

                <TextBlock Text="实用功能" Style="{StaticResource MetroSectionLabelStyle}" Margin="0,0,0,8" />

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="防撤回" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="对方撤回后本地仍可见原文" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding AntiRecall, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="显示撤回提示" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="有人撤回时在会话里插一条提示" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding ShowRevokeNotice, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="双击戳一戳" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="双击对方气泡发送戳一戳" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding DoubleTapNudge, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="发送前确认" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="点发送时再确认一次，防误触" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding ConfirmBeforeSend, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="复制带发送者" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="多选复制时每行前加昵称" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding CopyWithSender, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="来消息震动" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="新消息时手机震动（需开启消息通知）" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding VibrateOnMessage, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="聊天里：长按消息 → 多选 / 复制 / 转发 / 截图选中"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,4"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />

                <Border Height="1" Background="{StaticResource MetroSubtleBrush}" Margin="0,12,0,12" />

                <TextBlock Text="网关连接" Style="{StaticResource MetroSectionLabelStyle}" Margin="0,0,0,8" />

                <StackPanel Margin="0,4,0,8">
                    <TextBlock Text="服务器地址" FontSize="20" FontWeight="Light"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                    <TextBlock Text="本机 localhost；同 WiFi 填电脑局域网 IP；出门填 OpenFrp/Frp 访问主机"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,6" />
                    <TextBox Text="{Binding ServerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="localhost" InputScope="Url" />
                </StackPanel>
                <StackPanel Margin="0,4,0,8">
                    <TextBlock Text="服务器端口" FontSize="20" FontWeight="Light"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                    <TextBlock Text="默认 8765；若 Frp 远程端口不是 8765，改成面板上的远程端口"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,6" />
                    <TextBox Text="{Binding ServerPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="8765" InputScope="Number" />
                </StackPanel>
                <StackPanel Margin="0,4,0,8">
                    <TextBlock Text="网关访问密码" FontSize="20" FontWeight="Light"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                    <TextBlock Text="这是电脑管家的访问口令，不是 QQ 密码；与管家设置一致后才能连接"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,6" />
                    <PasswordBox x:Name="AccessPasswordBox" PasswordChanged="AccessPasswordBox_PasswordChanged"
                                 PlaceholderText="填写管家显示的访问密码" />
                </StackPanel>

                <Button Content="连接网关" Click="LoginButton_Click"
                        Background="{StaticResource MetroAccentBrush}" Foreground="White"
                        Padding="18,8" Margin="0,4,0,8" />
                <TextBlock Text="号在电脑上的 NapCat/NTQQ 已登录；此处只需地址、端口、密码即可进会话。"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,0,0,8" />

                <Border Height="1" Background="{StaticResource MetroSubtleBrush}" Margin="0,12,0,12" />

                <TextBlock Text="存储" FontSize="14" CharacterSpacing="40" Margin="0,0,0,8"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />

                <!-- 清除缓存 -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="清除缓存" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="{Binding CacheStatus}" FontSize="12"
                                   Foreground="{StaticResource MetroAccentBrush}" Margin="0,3,0,0"
                                   Visibility="{Binding HasCacheStatus, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="ClearCacheButton" Content="清除" Click="ClearCacheButton_Click"
                            Background="Transparent" BorderBrush="{StaticResource MetroSubtleBrush}" BorderThickness="1"
                            Foreground="{StaticResource MetroPrimaryTextBrush}" Padding="18,8" VerticalAlignment="Center" />
                </Grid>

                <!-- 文件下载目录 -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="文件下载目录" FontSize="20" FontWeight="Light"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock Text="{Binding DownloadFolderPath}" FontSize="12"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="PickDownloadFolderButton" Content="选择" Click="PickDownloadFolder_Click"
                            Background="Transparent" BorderBrush="{StaticResource MetroSubtleBrush}" BorderThickness="1"
                            Foreground="{StaticResource MetroPrimaryTextBrush}" Padding="18,8" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{StaticResource MetroSubtleBrush}" Margin="0,12,0,12" />

                <!-- 关于 -->
                <TextBlock Text="关于" FontSize="14" CharacterSpacing="40" Margin="0,0,0,8"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock Text="关于 QQ Reborn" FontSize="20" FontWeight="Light"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" Margin="0,4,0,6" />
                <TextBlock Text="{Binding VersionText}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="0,0,0,4" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
