<Page
    x:Class="QQReborn.App.Views.MomentDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="Back_Click" Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="动态详情" Style="{StaticResource ModernHeaderTitleStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="14,14">
            <StackPanel MaxWidth="720">
                <Border Style="{StaticResource ModernCardStyle}" Padding="14,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="46" Height="46">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AuthorAvatarPath}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AuthorName}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="{Binding TimeText}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding ImagePaths}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Margin="0,0,0,10" MaxWidth="560">
                                        <Image Source="{Binding}" MaxHeight="420" Stretch="Uniform" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="LikeButton" Click="Like_Click" Content="赞" Padding="16,8"
                                    Style="{StaticResource MetroChromeButtonStyle}" MinWidth="0" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding LikeText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernSettingsCardStyle}" Padding="14,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="评论" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding Comments}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MomentComment">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MetroPrimaryTextBrush}">
                                            <Run Text="{Binding Author}" FontWeight="SemiBold" /><Run Text="：" /><Run Text="{Binding Text}" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Replies}" Margin="14,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:MomentComment">
                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MetroSecondaryTextBrush}">
                                                        <Run Text="{Binding Author}" FontWeight="SemiBold" /><Run Text="：" /><Run Text="{Binding Text}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource ModernElevatedBrush}" CornerRadius="18"
                                    Padding="4,0" MinHeight="38">
                                <TextBox x:Name="CommentBox" PlaceholderText="写评论…" Background="Transparent" BorderThickness="0"
                                         Margin="10,4" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1" Content="发送" Click="SendComment_Click" Margin="8,0,0,0" Padding="16,8"
                                    Background="{StaticResource MetroAccentBrush}" Foreground="White" BorderThickness="0"
                                    FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
