<Page
    x:Class="QQReborn.App.Views.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    xmlns:views="using:QQReborn.App.Views"
    Background="{StaticResource MetroBackgroundBrush}">

    <Page.Resources>
        <!-- 对方：左 -->
        <DataTemplate x:Key="IncomingTemplate" x:DataType="models:ChatMessage">
            <StackPanel>
                <TextBlock Text="{Binding DividerText}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,8"
                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                           Visibility="{Binding ShowTimeDivider, Converter={StaticResource BoolToVisibility}}" />
                <Grid Margin="0,6,60,6" HorizontalAlignment="Left" MaxWidth="320">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding SenderAvatarPath}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left"
                                Holding="Bubble_Holding" RightTapped="Bubble_RightTapped" DoubleTapped="Bubble_DoubleTapped">
                        <TextBlock Text="{Binding SenderName}" FontSize="11"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="2,0,0,3" />
                        <!-- 引用 -->
                        <Border Background="{StaticResource MetroSubtleBrush}" BorderBrush="{StaticResource MetroAccentBrush}"
                                BorderThickness="3,0,0,0" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,3"
                                Visibility="{Binding HasReply, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ReplyPreview}" FontSize="11" TextWrapping="Wrap" MaxWidth="240"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </Border>
                        <Border Background="{StaticResource MetroBubbleOtherBrush}" Padding="12,9" HorizontalAlignment="Left"
                                Visibility="{Binding IsTextOnly, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15"
                                       Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        </Border>
                        <!-- 图文混排 / 多图 -->
                        <Border Background="{StaticResource MetroBubbleOtherBrush}" Padding="12,9" HorizontalAlignment="Left" MaxWidth="280"
                                Visibility="{Binding UseMixedLayout, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MessageElement">
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Text}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                            <Image Source="{Binding Url}" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" MaxWidth="180" MaxHeight="180" Stretch="Uniform" Margin="0,4,0,0"
                                                   Tapped="MixedImage_Tapped" />
                                            <Border Background="{StaticResource MetroSubtleBrush}" Padding="8,4" Visibility="{Binding IsVoice, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="[语音]" FontSize="13" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource MetroSubtleBrush}" Padding="8,4" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="[视频]" FontSize="13" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource MetroSubtleBrush}" Padding="8,4" Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <!-- 图片：点按进入全屏查看；无 URL 时显示占位，点按再向服务器解析 -->
                        <Border Background="{StaticResource MetroSubtleBrush}" Padding="0" HorizontalAlignment="Left"
                                Tapped="Image_Tapped"
                                Visibility="{Binding IsImageOnly, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Image Source="{Binding ImagePath}" MaxWidth="180" MaxHeight="180" Stretch="Uniform"
                                       Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal" Margin="14,12"
                                    Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B9;" FontSize="14"
                                      Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            <TextBlock Text="查看图片" FontSize="14" Margin="6,0,0,0"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="Transparent" Padding="0" HorizontalAlignment="Left"
                                Tapped="Image_Tapped"
                                Visibility="{Binding IsSticker, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding ImagePath}" Width="90" Height="90" Stretch="Uniform" />
                        </Border>
                        <Border Background="{StaticResource MetroBubbleOtherBrush}" Padding="12,9" HorizontalAlignment="Left"
                                Width="{Binding VoiceWidth}" Tapped="Voice_Tapped"
                                Visibility="{Binding IsVoice, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="16"
                                          Foreground="{StaticResource MetroPrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding VoiceText}" FontSize="14" Margin="10,0,0,0"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- 链接卡片 -->
                        <Border Background="{StaticResource MetroPanelBrush}" Padding="10" HorizontalAlignment="Left" Width="240"
                                Visibility="{Binding IsLinkCard, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding LinkThumb}" Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LinkTitle}" FontSize="14" FontWeight="SemiLight" TextWrapping="Wrap" MaxLines="2"
                                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                    <TextBlock Text="{Binding LinkSource}" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 文件卡片（位置卡风格：顶区图标 + 文件信息 + 操作提示） -->
                        <Border Background="{StaticResource MetroPanelBrush}" Padding="0" HorizontalAlignment="Left" Width="240"
                                Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}"
                                Tapped="File_Tapped">
                            <StackPanel>
                                <Grid Height="88" Background="#FF1A2430">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="34" HorizontalAlignment="Center" />
                                        <TextBlock Text="文件" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="12,10,12,10">
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiLight"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                    <TextBlock Text="{Binding FileSize}" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                    <TextBlock Text="{Binding FileActionHint}" FontSize="11" Margin="0,6,0,0"
                                               Foreground="{StaticResource MetroAccentBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 位置 -->
                        <Border Background="{StaticResource MetroPanelBrush}" Padding="0" HorizontalAlignment="Left" Width="220"
                                Visibility="{Binding IsLocation, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Rectangle Width="220" Height="100">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding PlaceThumb}" Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel Margin="10,8,10,10">
                                    <TextBlock Text="{Binding PlaceName}" FontSize="14" FontWeight="SemiLight" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                    <TextBlock Text="{Binding PlaceAddress}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 表情回应 -->
                        <Border Background="{StaticResource MetroSubtleBrush}" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ReactionText}" FontSize="13"
                                       Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- 自己：右 -->
        <DataTemplate x:Key="OutgoingTemplate" x:DataType="models:ChatMessage">
            <StackPanel>
                <TextBlock Text="{Binding DividerText}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,8"
                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                           Visibility="{Binding ShowTimeDivider, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Margin="60,6,0,6" HorizontalAlignment="Right" MaxWidth="320"
                            Holding="Bubble_Holding" RightTapped="Bubble_RightTapped" DoubleTapped="Bubble_DoubleTapped">
                    <!-- 引用 -->
                    <Border Background="{StaticResource MetroSubtleBrush}" BorderBrush="{StaticResource MetroAccentBrush}"
                            BorderThickness="3,0,0,0" Padding="8,4" HorizontalAlignment="Right" Margin="0,0,0,3"
                            Visibility="{Binding HasReply, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ReplyPreview}" FontSize="11" TextWrapping="Wrap" MaxWidth="240"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </Border>
                    <Border Background="{StaticResource MetroAccentBrush}" Padding="12,9" HorizontalAlignment="Right"
                            Visibility="{Binding IsTextOnly, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" Foreground="White" />
                    </Border>
                    <!-- 图文混排 / 多图 -->
                    <Border Background="{StaticResource MetroAccentBrush}" Padding="12,9" HorizontalAlignment="Right" MaxWidth="280"
                            Visibility="{Binding UseMixedLayout, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Elements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MessageElement">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Text}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" FontSize="15" Foreground="White" />
                                        <Image Source="{Binding Url}" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" MaxWidth="180" MaxHeight="180" Stretch="Uniform" Margin="0,4,0,0"
                                           Tapped="MixedImage_Tapped" />
                                        <Border Background="{StaticResource MetroSubtleBrush}" Padding="8,4" Visibility="{Binding IsVoice, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="[语音]" FontSize="13" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                        </Border>
                                        <Border Background="{StaticResource MetroSubtleBrush}" Padding="8,4" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="[视频]" FontSize="13" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                        </Border>
                                        <Border Background="{StaticResource MetroSubtleBrush}" Padding="8,4" Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Background="{StaticResource MetroSubtleBrush}" Padding="0" HorizontalAlignment="Right"
                            Tapped="Image_Tapped"
                            Visibility="{Binding IsImageOnly, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Image Source="{Binding ImagePath}" MaxWidth="180" MaxHeight="180" Stretch="Uniform"
                                   Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="14,12"
                                    Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B9;" FontSize="14"
                                          Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                <TextBlock Text="查看图片" FontSize="14" Margin="6,0,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="Transparent" Padding="0" HorizontalAlignment="Right"
                            Tapped="Image_Tapped"
                            Visibility="{Binding IsSticker, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding ImagePath}" Width="90" Height="90" Stretch="Uniform" />
                    </Border>
                    <Border Background="{StaticResource MetroAccentBrush}" Padding="12,9" HorizontalAlignment="Right"
                            Width="{Binding VoiceWidth}" Tapped="Voice_Tapped"
                            Visibility="{Binding IsVoice, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding VoiceText}" FontSize="14" Margin="0,0,10,0"
                                       Foreground="White" VerticalAlignment="Center" />
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="16"
                                      Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- 链接卡片 -->
                    <Border Background="{StaticResource MetroPanelBrush}" Padding="10" HorizontalAlignment="Right" Width="240"
                            Visibility="{Binding IsLinkCard, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding LinkThumb}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LinkTitle}" FontSize="14" FontWeight="SemiLight" TextWrapping="Wrap" MaxLines="2"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="{Binding LinkSource}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- 文件卡片（位置卡风格） -->
                    <Border Background="{StaticResource MetroPanelBrush}" Padding="0" HorizontalAlignment="Right" Width="240"
                            Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}"
                            Tapped="File_Tapped">
                        <StackPanel>
                            <Grid Height="88" Background="#FF123248">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="34" HorizontalAlignment="Center" />
                                    <TextBlock Text="文件" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="12,10,12,10">
                                <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiLight"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="{Binding FileSize}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                <TextBlock Text="{Binding FileActionHint}" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{StaticResource MetroAccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- 位置 -->
                    <Border Background="{StaticResource MetroPanelBrush}" Padding="0" HorizontalAlignment="Right" Width="220"
                            Visibility="{Binding IsLocation, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Rectangle Width="220" Height="100">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding PlaceThumb}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Margin="10,8,10,10">
                                <TextBlock Text="{Binding PlaceName}" FontSize="14" FontWeight="SemiLight" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="{Binding PlaceAddress}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- 表情回应 -->
                    <Border Background="{StaticResource MetroSubtleBrush}" Padding="8,3" HorizontalAlignment="Right" Margin="0,4,0,0"
                            Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ReactionText}" FontSize="13"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,2,0">
                        <TextBlock Text="发送中…" FontSize="11" Foreground="{StaticResource MetroSecondaryTextBrush}"
                                   Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="发送失败" FontSize="11" Foreground="{StaticResource MetroDangerBrush}"
                                   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ReadText}" FontSize="11" Foreground="{StaticResource MetroSecondaryTextBrush}"
                                   Visibility="{Binding ShowReadState, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 视频消息 对方：左 -->
        <DataTemplate x:Key="IncomingVideoTemplate" x:DataType="models:ChatMessage">
            <StackPanel>
                <TextBlock Text="{Binding DividerText}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,8"
                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                           Visibility="{Binding ShowTimeDivider, Converter={StaticResource BoolToVisibility}}" />
                <Grid Margin="0,6,60,6" HorizontalAlignment="Left" MaxWidth="320">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding SenderAvatarPath}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left"
                                Holding="Bubble_Holding" RightTapped="Bubble_RightTapped" DoubleTapped="Bubble_DoubleTapped">
                        <TextBlock Text="{Binding SenderName}" FontSize="11"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" Margin="2,0,0,3" />
                        <Border Background="{StaticResource MetroBubbleOtherBrush}" Padding="12,9" HorizontalAlignment="Left"
                                Tapped="Video_Tapped">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE714;" FontSize="16"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="[视频]" FontSize="14" Margin="10,0,0,0"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding VideoText}" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- 视频消息 自己：右 -->
        <DataTemplate x:Key="OutgoingVideoTemplate" x:DataType="models:ChatMessage">
            <StackPanel>
                <TextBlock Text="{Binding DividerText}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,8"
                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                           Visibility="{Binding ShowTimeDivider, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Margin="60,6,0,6" HorizontalAlignment="Right" MaxWidth="320"
                            Holding="Bubble_Holding" RightTapped="Bubble_RightTapped" DoubleTapped="Bubble_DoubleTapped">
                    <Border Background="{StaticResource MetroAccentBrush}" Padding="12,9" HorizontalAlignment="Right"
                            Tapped="Video_Tapped">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE714;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="[视频]" FontSize="14" Margin="10,0,0,0"
                                       Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VideoText}" FontSize="14" Margin="8,0,0,0"
                                       Foreground="White" Opacity="0.8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,2,0">
                        <TextBlock Text="发送中…" FontSize="11" Foreground="{StaticResource MetroSecondaryTextBrush}"
                                   Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="发送失败" FontSize="11" Foreground="{StaticResource MetroDangerBrush}"
                                   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ReadText}" FontSize="11" Foreground="{StaticResource MetroSecondaryTextBrush}"
                                   Visibility="{Binding ShowReadState, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 系统消息：居中灰字 -->
        <DataTemplate x:Key="SystemTemplate" x:DataType="models:ChatMessage">
            <StackPanel>
                <TextBlock Text="{Binding DividerText}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,8"
                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                           Visibility="{Binding ShowTimeDivider, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Text}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,6,0,6"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>
        </DataTemplate>

        <views:MessageTemplateSelector x:Key="MessageSelector"
                                       IncomingTemplate="{StaticResource IncomingTemplate}"
                                       OutgoingTemplate="{StaticResource OutgoingTemplate}"
                                       SystemTemplate="{StaticResource SystemTemplate}"
                                       IncomingVideoTemplate="{StaticResource IncomingVideoTemplate}"
                                       OutgoingVideoTemplate="{StaticResource OutgoingVideoTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- WP-style hero title -->
        <Grid Grid.Row="0" Margin="19,10,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="聊天" Style="{StaticResource MetroPageTitleStyle}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource MetroHeroTitleStyle}"
                           Margin="0,-2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ChatBgButton" Click="ChatBgButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE790;" FontSize="22" />
            </Button>
            <Button Grid.Column="2" x:Name="GroupInfoButton" Click="GroupInfoButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="群"
                    Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="3" x:Name="MultiSelectHeaderButton" Click="MultiSelectHeader_Click"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                    Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}"
                    ToolTipService.ToolTip="多选">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE762;" FontSize="20" />
            </Button>
            <Button Grid.Column="4" x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="22" />
            </Button>
        </Grid>

        <!-- 消息 (背景由 LocalSettings "ChatBackground" 在代码中设置到 MessageArea) -->
        <Grid Grid.Row="1" x:Name="MessageArea" Background="{StaticResource MetroBackgroundBrush}"
              Tapped="MessageArea_Tapped">
            <ListView x:Name="MessageList"
                      ItemsSource="{Binding Messages}"
                      ItemTemplateSelector="{StaticResource MessageSelector}"
                      SelectionMode="None"
                      Padding="24,4,16,8">
                <ListView.Header>
                    <!-- 查看更多消息：上拉/点击拉取更早的云端历史（好友漫游 / 群序列历史；mock 为伪造数据） -->
                    <Grid Padding="0,6,0,10" HorizontalAlignment="Stretch"
                          Visibility="{Binding CanLoadEarlier, Converter={StaticResource BoolToVisibility}}">
                        <Border x:Name="LoadEarlierStrip" Background="{StaticResource MetroSubtleBrush}"
                                Padding="14,7" HorizontalAlignment="Center"
                                Tapped="LoadEarlierStrip_Tapped">
                            <TextBlock Text="查看更多消息" FontSize="12" FontWeight="SemiLight"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </Border>
                    </Grid>
                </ListView.Header>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- 正在输入 + 引用条 + 待发图片（图文混排） -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="对方正在输入…" FontSize="12" Margin="24,0,0,4"
                       Foreground="{StaticResource MetroSecondaryTextBrush}"
                       Visibility="{Binding IsPeerTyping, Converter={StaticResource BoolToVisibility}}" />
            <Grid Background="{StaticResource MetroSubtleBrush}" Padding="12,6" Margin="0,0,0,0"
                  Visibility="{Binding HasReplyTarget, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ReplyTargetPreview}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <Button Grid.Column="1" x:Name="ClearReplyButton" Click="ClearReplyButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="8,0" VerticalAlignment="Center"
                        Foreground="{StaticResource MetroSecondaryTextBrush}">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="14" />
                </Button>
            </Grid>
            <Grid Background="{StaticResource MetroSubtleBrush}" Padding="10,8"
                  Visibility="{Binding HasPendingImages, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0" ItemsSource="{Binding PendingImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="56" Height="56" Margin="0,0,8,0">
                                <Image Source="{Binding}" Stretch="UniformToFill" />
                                <Button Content="×" Width="20" Height="20" Padding="0" FontSize="12"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#99000000" Foreground="White" BorderThickness="0"
                                        Tag="{Binding}" Click="RemovePendingImage_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="1" Content="清空" Click="ClearPendingImages_Click"
                        Background="Transparent" BorderThickness="0" Padding="8,4" VerticalAlignment="Top"
                        Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="12" />
            </Grid>
        </StackPanel>

        <!-- @ Mention Picker -->
        <!-- Mentions are implemented using MenuFlyout in ConversationPage.xaml.cs (InputBox_TextChanged) -->

        <!-- 多选工具条（与输入栏同槽，切换显示） -->
        <Grid x:Name="MultiSelectBar" Grid.Row="3" Background="{StaticResource MetroChromeBrush}"
              Padding="10,10" MinHeight="56" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MultiSelectCountText" Grid.Column="0" Text="已选 0 条"
                       VerticalAlignment="Center" FontSize="14"
                       Foreground="{StaticResource MetroPrimaryTextBrush}" />
            <Button Grid.Column="1" Content="复制" Click="MultiCopy_Click" Margin="4,0"
                    Style="{StaticResource MetroChromeButtonStyle}" Padding="10,8" MinWidth="0"
                    HorizontalAlignment="Left" />
            <Button Grid.Column="2" Content="转发" Click="MultiForward_Click" Margin="4,0"
                    Style="{StaticResource MetroChromeButtonStyle}" Padding="10,8" MinWidth="0"
                    HorizontalAlignment="Left" />
            <Button Grid.Column="3" Content="截图" Click="MultiScreenshot_Click" Margin="4,0"
                    Style="{StaticResource MetroChromeButtonStyle}" Padding="10,8" MinWidth="0"
                    HorizontalAlignment="Left" />
            <Button Grid.Column="4" Content="删除" Click="MultiDelete_Click" Margin="4,0"
                    Style="{StaticResource MetroChromeButtonStyle}" Padding="10,8" MinWidth="0"
                    HorizontalAlignment="Left" />
            <Button Grid.Column="5" Content="取消" Click="MultiSelectCancel_Click" Margin="4,0"
                    Style="{StaticResource MetroAccentButtonStyle}" Padding="10,8" MinWidth="0"
                    HorizontalAlignment="Left" />
        </Grid>

        <!-- 输入栏 -->
        <Grid x:Name="InputBar" Grid.Row="3" Background="{StaticResource MetroPanelBrush}" Padding="8,8" MinHeight="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="EmojiButton" Click="EmojiButton_Click" Background="Transparent"
                    BorderThickness="0" Padding="6" VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76E;" FontSize="20" />
            </Button>
            <Button Grid.Column="1" x:Name="ImageButton" Click="ImageButton_Click" Background="Transparent"
                    BorderThickness="0" Padding="6" VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B9;" FontSize="20" />
            </Button>
            <Button Grid.Column="2" x:Name="VoiceButton" Click="VoiceButton_Click" Background="Transparent"
                    BorderThickness="0" Padding="6" VerticalAlignment="Center" FontSize="20">
                <FontIcon FontFamily="Segoe MDL2 Assets" x:Name="VoiceGlyph" Glyph="&#xE720;" FontSize="20" />
            </Button>
            <Button Grid.Column="3" x:Name="FileButton" Click="FileButton_Click" Background="Transparent"
                    BorderThickness="0" Padding="6" VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="20" />
            </Button>
            <Button Grid.Column="4" x:Name="LocationButton" Click="LocationButton_Click" Background="Transparent"
                    BorderThickness="0" Padding="6" VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE81D;" FontSize="20" />
            </Button>
            <TextBox Grid.Column="5" x:Name="InputBox"
                     Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="输入消息…"
                     KeyDown="InputBox_KeyDown"
                     TextChanged="InputBox_TextChanged"
                     AcceptsReturn="True"
                     TextWrapping="Wrap" MaxHeight="100"
                     VerticalAlignment="Center" Margin="6,0,0,0" />
            <Button Grid.Column="6" x:Name="SendButton" Content="发送"
                    Click="SendButton_Click"
                    IsEnabled="{Binding CanSend}"
                    Background="{StaticResource MetroAccentBrush}" Foreground="White"
                    BorderThickness="0" Margin="8,0,0,0" Padding="16,10" VerticalAlignment="Center" />
        </Grid>

        <!-- 录音提示 -->
        <Border Grid.Row="4" x:Name="RecordingBar" Background="{StaticResource MetroPanelBrush}" Visibility="Collapsed" Padding="24,12">
            <TextBlock x:Name="RecordingHint" Text="● 录音中… 0″   再次点击麦克风结束并发送"
                       Foreground="{StaticResource MetroDangerBrush}" FontSize="14" />
        </Border>

        <!-- 表情/贴纸面板 -->
        <Grid Grid.Row="4" x:Name="EmojiPanel" Visibility="Collapsed"
              Background="{StaticResource MetroPanelBrush}" Height="248">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,8,0,4">
                <TextBlock x:Name="TabEmoji" Text="表情" FontSize="15" Margin="0,0,20,0" Tapped="Tab_Emoji"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                <TextBlock x:Name="TabClassic" Text="经典" FontSize="15" Margin="0,0,20,0" Tapped="Tab_Classic"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock x:Name="TabFav" Text="收藏" FontSize="15" Tapped="Tab_Fav"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>

            <GridView Grid.Row="1" x:Name="EmojiGrid" ItemsSource="{Binding Emojis}"
                      IsItemClickEnabled="True" SelectionMode="None" ItemClick="Emoji_ItemClick" Padding="10,4">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="26" Width="44" Height="44" TextAlignment="Center" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView Grid.Row="1" x:Name="StickerGrid" Visibility="Collapsed" ItemsSource="{Binding Stickers}"
                      IsItemClickEnabled="True" SelectionMode="None" ItemClick="Sticker_ItemClick" Padding="10,4">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding}" Width="50" Height="50" Margin="3" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid Grid.Row="1" x:Name="FavPanel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="收藏表情" FontSize="16" Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="登录后同步你 QQ 里收藏的表情包" FontSize="12" Margin="0,8,0,0"
                               Foreground="{StaticResource MetroSubtleBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
