<Page
    x:Class="QQReborn.App.Views.AddFriendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="加好友 / 加群" Style="{StaticResource ModernHeaderTitleStyle}" />
        </Grid>

        <Grid Grid.Row="1" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ModernSearchBarStyle}" Margin="0" MinHeight="44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Grid.Column="0" Glyph="&#xE721;" FontSize="15"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    <TextBox Grid.Column="1" x:Name="QueryBox"
                             PlaceholderText="输入 QQ号 / 群号 / 昵称"
                             Background="Transparent" BorderThickness="0"
                             FontSize="15"
                             Foreground="{StaticResource MetroPrimaryTextBrush}"
                             KeyDown="QueryBox_KeyDown"
                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Button Grid.Column="1" x:Name="SearchButton" Content="搜索"
                    Click="SearchButton_Click"
                    Background="{StaticResource MetroAccentBrush}" Foreground="White"
                    BorderThickness="0" Margin="8,0,0,0" Padding="18,12" VerticalAlignment="Stretch"
                    FontWeight="SemiBold" />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="EmptyHint" Visibility="Collapsed"
                   Text="请输入要查找的 QQ号 / 群号 / 昵称" FontSize="12"
                   Margin="16,0,16,4" Foreground="{StaticResource MetroDangerBrush}" />

        <Grid Grid.Row="3">
            <StackPanel x:Name="IdleHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource ModernAccentSoftBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <FontIcon Glyph="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                              Foreground="{StaticResource MetroAccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="查找好友或群" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="QQ号 · 群号 · 昵称" FontSize="12" Margin="0,6,0,0"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <Border x:Name="ResultCard" Visibility="Collapsed"
                    Style="{StaticResource ModernCardStyle}"
                    VerticalAlignment="Top" Margin="12,4,12,0" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="56" Height="56" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="ms-appx:///Assets/Avatars/DefaultUserAvatar.png" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock x:Name="ResultName" Text="" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetroPrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ResultUin" Text="" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            <TextBlock x:Name="ResultSignature" Text="" FontSize="12" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="AddButton" Content="加好友"
                            Click="AddButton_Click"
                            Style="{StaticResource MetroAccentButtonStyle}" Margin="0,16,0,0" Padding="0,12" />

                    <TextBlock x:Name="SentHint" Visibility="Collapsed"
                               Text="申请已发送，等待对方验证" FontSize="12" Margin="2,10,0,0"
                               Foreground="{StaticResource ModernSuccessBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
