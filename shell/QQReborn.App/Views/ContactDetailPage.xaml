<Page
    x:Class="QQReborn.App.Views.ContactDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题头部 -->
        <Grid Grid.Row="0" Margin="24,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="详细资料" FontSize="13" CharacterSpacing="40"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
            <Button Grid.Column="1" x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                    BorderThickness="0" Padding="10,6" VerticalAlignment="Center"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="&#x2190;" />
        </Grid>

        <!-- 资料主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,20,8">

                <!-- 头像 + 名称 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="96" Height="96" VerticalAlignment="Top">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding DisplayName}" FontSize="30" FontWeight="Light"
                                   CharacterSpacing="-20"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UinText}" FontSize="14" FontWeight="Light" Margin="0,6,0,0"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource MetroAccentBrush}"
                                     Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource MetroSubtleBrush}"
                                     Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="13" Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 个性签名 -->
                <Border Background="{StaticResource MetroPanelBrush}" Padding="14,12" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="个性签名" FontSize="12" CharacterSpacing="30"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        <TextBlock Text="{Binding SignatureText}" FontSize="15" FontWeight="Light" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- 资料块 -->
                <Border Background="{StaticResource MetroPanelBrush}" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="资料" FontSize="12" CharacterSpacing="30"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        <TextBlock Text="{Binding DetailText}" FontSize="15" FontWeight="Light" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="在线状态" FontSize="14" FontWeight="Light"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="14" FontWeight="Light"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Grid Grid.Row="2" Background="{StaticResource MetroPanelBrush}" Padding="20,12" Margin="0,8,0,0">
            <Button x:Name="MessageButton" Content="发消息"
                    Click="MessageButton_Click"
                    Background="{StaticResource MetroAccentBrush}" Foreground="White"
                    BorderThickness="0" Padding="0,12" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" FontSize="16" />
        </Grid>
    </Grid>
</Page>
