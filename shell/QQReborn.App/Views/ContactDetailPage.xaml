<Page
    x:Class="QQReborn.App.Views.ContactDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="详细资料" Style="{StaticResource ModernHeaderTitleStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,14,14,16">

                <Border Style="{StaticResource ModernCardStyle}" Padding="16,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="80" Height="80" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarCache}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetroPrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UinText}" FontSize="13" Margin="0,6,0,0"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{StaticResource ModernSuccessBrush}"
                                         Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{StaticResource MetroSubtleBrush}"
                                         Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernSettingsCardStyle}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="个性签名" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        <TextBlock Text="{Binding SignatureText}" FontSize="14" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernSettingsCardStyle}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="资料" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        <TextBlock Text="{Binding DetailText}" FontSize="14" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" Margin="0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="在线状态" FontSize="14"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="14"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource ModernHairlineBrush}" Margin="0,12" />
                        <Grid Tapped="RemarkRow_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="备注" FontSize="14"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" x:Name="RemarkText" Text="" FontSize="14"
                                       HorizontalAlignment="Right" Margin="12,0,8,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MetroPrimaryTextBrush}" />
                            <FontIcon Grid.Column="2" Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="删除好友" Click="DeleteFriend_Click"
                        Style="{StaticResource ModernDangerButtonStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,1,0,0"
              Padding="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="LikeButton" Content="赞一下"
                    Click="LikeButton_Click"
                    Style="{StaticResource MetroChromeButtonStyle}"
                    Foreground="{StaticResource MetroAccentBrush}" Padding="0,12" />
            <Button Grid.Column="2" x:Name="MessageButton" Content="发消息"
                    Click="MessageButton_Click"
                    Style="{StaticResource MetroAccentButtonStyle}" Padding="0,12" />
        </Grid>
    </Grid>
</Page>
