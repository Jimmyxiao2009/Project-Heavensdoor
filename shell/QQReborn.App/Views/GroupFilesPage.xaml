<Page
    x:Class="QQReborn.App.Views.GroupFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="群文件" FontSize="13" CharacterSpacing="40"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock x:Name="TitleText" Text="根目录" FontSize="28" FontWeight="Light"
                           CharacterSpacing="-20"
                           Foreground="{StaticResource MetroPrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="NewFolderButton" Grid.Column="1" Content="新建文件夹" Click="NewFolder_Click"
                    Background="Transparent" BorderThickness="0" Padding="8,6"
                    Foreground="{StaticResource MetroAccentBrush}" FontSize="13"
                    VerticalAlignment="Top" Margin="0,8,4,0" Visibility="Collapsed" />
            <Button Grid.Column="2" Click="BackButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="&#x2190;" />
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="FileList" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="FileList_ItemClick" Padding="12,0,12,24">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GroupFileEntry">
                        <Grid Padding="8,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE8B7;" FontSize="22" Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource MetroAccentBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SizeText}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="加载中…" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="14"
                       Foreground="{StaticResource MetroSecondaryTextBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
