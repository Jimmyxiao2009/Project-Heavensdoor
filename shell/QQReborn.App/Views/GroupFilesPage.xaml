<Page
    x:Class="QQReborn.App.Views.GroupFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="群文件" FontSize="11" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock x:Name="TitleText" Text="根目录" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource MetroPrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="NewFolderButton" Grid.Column="2" Content="新建" Click="NewFolder_Click"
                    Style="{StaticResource ModernGhostButtonStyle}" Margin="0,0,8,0" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="FileList" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="FileList_ItemClick" Padding="12,10,12,24">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GroupFileEntry">
                        <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,8" Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource ModernAccentSoftBrush}" Margin="0,0,12,0">
                                    <FontIcon FontFamily="Segoe MDL2 Assets"
                                              Glyph="&#xE8B7;" FontSize="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{StaticResource MetroAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource MetroPrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="加载中…" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource MetroSecondaryTextBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
