<Page
    x:Class="QQReborn.App.Views.AccountLoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 大标题头部 -->
        <Grid Grid.Row="0" Margin="24,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="账号" FontSize="13" CharacterSpacing="40"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock Text="登录 QQ" FontSize="36" FontWeight="Light" CharacterSpacing="-20"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="&#x2190;" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Margin="24,8,24,24" HorizontalAlignment="Center">

                <TextBlock Text="{Binding StatusText}" FontSize="24" FontWeight="Light"
                           Foreground="{StaticResource MetroPrimaryTextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,6" />
                <TextBlock Text="{Binding StatusDetailText}" FontSize="14" TextWrapping="Wrap"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" MaxWidth="320"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20" />

                <Border Width="240" Height="240" Background="{StaticResource MetroPanelBrush}"
                        Visibility="{Binding HasQrImage, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,8,0,24">
                    <Image Source="{Binding QrImage}" Stretch="Uniform" Margin="12" />
                </Border>

                <Button Content="开始登录" Click="StartLoginButton_Click"
                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVisibility}}"
                        Background="{StaticResource MetroAccentBrush}" Foreground="White"
                        Padding="32,12" FontSize="18" HorizontalAlignment="Center" Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
