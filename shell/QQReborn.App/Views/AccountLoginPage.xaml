<Page
    x:Class="QQReborn.App.Views.AccountLoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="连接网关" Style="{StaticResource ModernHeaderTitleStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Margin="24,28,24,32" HorizontalAlignment="Center" MaxWidth="360">

                <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{StaticResource MetroAccentBrush}" Margin="0,0,0,18">
                    <TextBlock Text="Q" FontSize="30" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource MetroPrimaryTextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusDetailText}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20" />

                <ProgressRing IsActive="{Binding IsBusy}" Width="40" Height="40" Margin="0,0,0,16"
                              Foreground="{StaticResource MetroAccentBrush}"
                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <Border Width="240" Height="240" Background="{StaticResource MetroPanelBrush}"
                        CornerRadius="16" BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="1"
                        Visibility="{Binding HasQrImage, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,4,0,24" HorizontalAlignment="Center">
                    <Image Source="{Binding QrImage}" Stretch="Uniform" Margin="14" />
                </Border>

                <Button Content="开始连接" Click="StartLoginButton_Click"
                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource MetroAccentButtonStyle}"
                        MaxWidth="280" HorizontalAlignment="Center" Padding="32,12" FontSize="16" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
