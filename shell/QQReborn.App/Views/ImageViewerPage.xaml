<Page
    x:Class="QQReborn.App.Views.ImageViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000"
    RequestedTheme="Dark">

    <Grid x:Name="Root"
          Background="#FF000000"
          PointerWheelChanged="Root_PointerWheelChanged">

        <Image x:Name="Viewer"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               ManipulationMode="Scale,TranslateX,TranslateY,TranslateInertia"
               ManipulationDelta="Viewer_ManipulationDelta"
               ManipulationInertiaStarting="Viewer_ManipulationInertiaStarting"
               ManipulationCompleted="Viewer_ManipulationCompleted"
               DoubleTapped="Viewer_DoubleTapped"
               Tapped="Viewer_Tapped"
               IsTapEnabled="True"
               IsDoubleTapEnabled="True"
               IsRightTapEnabled="False"
               IsHoldingEnabled="False"
               RenderTransformOrigin="0,0">
            <Image.RenderTransform>
                <CompositeTransform x:Name="Xf" />
            </Image.RenderTransform>
        </Image>

        <TextBlock x:Name="StatusText"
                   Text="加载中…"
                   FontSize="14"
                   Foreground="#FFAAAAAA"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />

        <!-- Top chrome -->
        <Grid x:Name="TopChrome" VerticalAlignment="Top" Height="52" Background="#66000000">
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Content="←"
                    FontSize="22"
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    Padding="14,8" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="IndexLabel"
                           Text=""
                           FontSize="13"
                           Foreground="#FFCCCCCC"
                           Margin="0,0,12,0"
                           IsHitTestVisible="False" />
                <TextBlock x:Name="ZoomLabel"
                           Text="适应"
                           FontSize="13"
                           Foreground="#FFCCCCCC"
                           IsHitTestVisible="False" />
            </StackPanel>
        </Grid>

        <!-- Side prev/next (visible when gallery has >1) -->
        <Button x:Name="PrevButton"
                Content="‹"
                Click="PrevButton_Click"
                FontSize="36"
                Foreground="White"
                Background="#44000000"
                BorderThickness="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="4,0,0,0"
                Padding="10,20"
                Visibility="Collapsed" />
        <Button x:Name="NextButton"
                Content="›"
                Click="NextButton_Click"
                FontSize="36"
                Foreground="White"
                Background="#44000000"
                BorderThickness="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,4,0"
                Padding="10,20"
                Visibility="Collapsed" />

        <!-- Bottom actions -->
        <Border x:Name="BottomChrome"
                VerticalAlignment="Bottom"
                Background="#66000000"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="FitButton"
                        Content="适应"
                        Click="FitButton_Click"
                        Foreground="White"
                        Background="#33FFFFFF"
                        BorderThickness="0"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        FontSize="14" />
                <Button x:Name="OneToOneButton"
                        Content="1:1"
                        Click="OneToOneButton_Click"
                        Foreground="White"
                        Background="#33FFFFFF"
                        BorderThickness="0"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        FontSize="14" />
                <Button x:Name="SaveButton"
                        Content="保存"
                        Click="SaveButton_Click"
                        Foreground="White"
                        Background="#3312B7F5"
                        BorderThickness="0"
                        Padding="20,8"
                        FontSize="14"
                        IsEnabled="False" />
            </StackPanel>
        </Border>

        <Border x:Name="Toast"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="#CC222222"
                Padding="18,10"
                CornerRadius="4"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Text="" Foreground="White" FontSize="14" />
        </Border>
    </Grid>
</Page>
