<Page
    x:Class="QQReborn.App.Views.FriendRequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    Background="{StaticResource MetroBackgroundBrush}">

    <Page.Resources>
        <!-- 好友申请行 -->
        <DataTemplate x:Key="FriendRequestTemplate" x:DataType="models:FriendRequest">
            <Grid Height="76" Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarCache}}" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiLight"
                               Foreground="{StaticResource MetroPrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Message}" FontSize="12"
                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding NotHandled, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="拒绝" Click="RejectButton_Click"
                            Background="{StaticResource MetroPanelBrush}"
                            Foreground="{StaticResource MetroSecondaryTextBrush}"
                            BorderThickness="0" Padding="14,8" FontSize="14" Margin="0,0,8,0" />
                    <Button Content="同意" Click="AcceptButton_Click"
                            Background="{StaticResource MetroAccentBrush}" Foreground="White"
                            BorderThickness="0" Padding="16,8" FontSize="14" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="已处理" FontSize="14" VerticalAlignment="Center"
                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                           Visibility="{Binding Handled, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="RequestListStyle" TargetType="ListView">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题头部 -->
        <Grid Grid.Row="0" Margin="24,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="联系人" FontSize="13" CharacterSpacing="40"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock Text="新朋友" FontSize="36" FontWeight="Light" CharacterSpacing="-20"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button x:Name="GroupNotifButton" Click="GroupNotifButton_Click" Content="群通知"
                        Background="{StaticResource MetroSubtleBrush}" Foreground="{StaticResource MetroPrimaryTextBrush}"
                        BorderThickness="0" Padding="12,6" FontSize="13" Margin="0,0,8,0" />
                <Button x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="10,6"
                        Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="&#x2190;" />
            </StackPanel>
        </Grid>

        <!-- 申请列表 / 空状态 -->
        <Grid Grid.Row="1">
            <ListView x:Name="RequestList"
                      ItemsSource="{Binding Requests}"
                      ItemTemplate="{StaticResource FriendRequestTemplate}"
                      Style="{StaticResource RequestListStyle}"
                      SelectionMode="None"
                      Padding="24,4,0,8"
                      Visibility="{Binding HasRequests, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasRequests, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="暂无新朋友" FontSize="20" FontWeight="Light"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="有人申请加你为好友时会出现在这里" FontSize="13" Margin="0,8,0,0"
                           Foreground="{StaticResource MetroSubtleBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
