<Page
    x:Class="QQReborn.App.Views.FriendRequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    Background="{StaticResource MetroBackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="FriendRequestTemplate" x:DataType="models:FriendRequest">
            <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,8" Padding="12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarCache}}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Message}" FontSize="12"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding NotHandled, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="拒绝" Click="RejectButton_Click"
                                Style="{StaticResource MetroChromeButtonStyle}"
                                Padding="12,8" FontSize="13" Margin="0,0,6,0" MinWidth="0"
                                HorizontalAlignment="Left" />
                        <Button Content="同意" Click="AcceptButton_Click"
                                Background="{StaticResource MetroAccentBrush}" Foreground="White"
                                BorderThickness="0" Padding="14,8" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource ModernElevatedBrush}" CornerRadius="10"
                            Padding="10,6" VerticalAlignment="Center"
                            Visibility="{Binding Handled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="已处理" FontSize="12"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="RequestListStyle" TargetType="ListView">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="新朋友" Style="{StaticResource ModernHeaderTitleStyle}" />
            <Button Grid.Column="2" x:Name="GroupNotifButton" Click="GroupNotifButton_Click" Content="群通知"
                    Style="{StaticResource ModernGhostButtonStyle}" Margin="0,0,8,0" />
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="RequestList"
                      ItemsSource="{Binding Requests}"
                      ItemTemplate="{StaticResource FriendRequestTemplate}"
                      Style="{StaticResource RequestListStyle}"
                      SelectionMode="None"
                      Padding="12,12,12,12"
                      Visibility="{Binding HasRequests, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasRequests, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource ModernElevatedBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <FontIcon Glyph="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                              Foreground="{StaticResource MetroSecondaryTextBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="暂无新朋友" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="有人申请加你为好友时会出现在这里" FontSize="12" Margin="0,6,0,0"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
