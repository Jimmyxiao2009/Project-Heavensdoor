<Page
    x:Class="QQReborn.App.Views.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000">

    <Grid>
        <MediaElement x:Name="Player" AutoPlay="True" AreTransportControlsEnabled="True"
                      Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Button x:Name="BackButton" Click="BackButton_Click"
                Style="{StaticResource ModernIconButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"
                Background="#66000000">
            <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" />
        </Button>
    </Grid>
</Page>
