<Page
    x:Class="QQReborn.App.Views.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000">

    <Grid>
        <MediaElement x:Name="Player" AutoPlay="True" AreTransportControlsEnabled="True"
                      Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Button x:Name="BackButton" Click="BackButton_Click" Content="←" FontSize="24"
                Foreground="White" Background="#66000000" BorderThickness="0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="12,6" />
    </Grid>
</Page>
