<Page
    x:Class="QQReborn.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    xmlns:mvvm="using:QQReborn.App.Mvvm"
    Background="{StaticResource MetroBackgroundBrush}">

    <Page.Resources>
        <mvvm:SearchKindToTagConverter x:Key="KindToTag" />

        <CollectionViewSource x:Name="ResultsSource" IsSourceGrouped="True"
                              Source="{Binding Sections}" ItemsPath="Items" />

        <!-- 搜索结果行 -->
        <DataTemplate x:Key="SearchResultTemplate" x:DataType="models:SearchResult">
            <Grid Height="68" Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiLight"
                               Foreground="{StaticResource MetroPrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12"
                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TimeText}" FontSize="11"
                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                               HorizontalAlignment="Right"
                               Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Kind, Converter={StaticResource KindToTag}}" FontSize="11"
                               Foreground="{StaticResource MetroSubtleBrush}"
                               HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="SearchListStyle" TargetType="ListView">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题头部 -->
        <Grid Grid.Row="0" Margin="24,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="搜索" FontSize="13" CharacterSpacing="40"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
            <Button Grid.Column="1" x:Name="CancelButton" Click="CancelButton_Click"
                    Background="Transparent" BorderThickness="0" Padding="10,6"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="15" Content="取消" />
        </Grid>

        <!-- 搜索框 -->
        <Grid Grid.Row="1" Margin="24,4,16,8" Background="{StaticResource MetroPanelBrush}" MinHeight="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon FontFamily="Segoe MDL2 Assets" Grid.Column="0" Glyph="&#xE721;" FontSize="18" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox Grid.Column="1" x:Name="SearchBox"
                     Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="搜索联系人、群、聊天记录"
                     Background="Transparent" BorderThickness="0"
                     FontSize="18" FontWeight="Light"
                     Foreground="{StaticResource MetroPrimaryTextBrush}"
                     VerticalAlignment="Center" Margin="2,0,8,0" />
        </Grid>

        <!-- 结果 / 空状态 / 提示 -->
        <Grid Grid.Row="2">
            <ListView x:Name="ResultsList"
                      ItemsSource="{Binding Source={StaticResource ResultsSource}}"
                      ItemTemplate="{StaticResource SearchResultTemplate}"
                      Style="{StaticResource SearchListStyle}"
                      IsItemClickEnabled="True" SelectionMode="None"
                      ItemClick="ResultsList_ItemClick"
                      Padding="24,0,0,8"
                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="SemiLight"
                                           CharacterSpacing="40" Margin="0,18,0,6"
                                           Foreground="{StaticResource MetroAccentBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <!-- 无匹配结果 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="无匹配结果" FontSize="20" FontWeight="Light"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="换个关键词试试" FontSize="13" Margin="0,8,0,0"
                           Foreground="{StaticResource MetroSubtleBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 空闲提示 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="搜索点什么吧" FontSize="20" FontWeight="Light"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="联系人 · 群聊 · 聊天记录" FontSize="13" Margin="0,8,0,0"
                           Foreground="{StaticResource MetroSubtleBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
