<Page
    x:Class="QQReborn.App.Views.ProfilePlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" x:Name="TitleText" Text="" Style="{StaticResource ModernHeaderTitleStyle}" />
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource ModernElevatedBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <FontIcon x:Name="GlyphText" Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{StaticResource MetroSecondaryTextBrush}" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="这里什么都没有" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="HintText" Text="登录后同步" FontSize="12" Margin="0,6,0,0"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <ListView x:Name="ResourceList" Visibility="Collapsed" Margin="12,12,12,18"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="ResourceList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,8" Padding="12,12" Height="64">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource ModernAccentSoftBrush}" Margin="0,0,12,0">
                                    <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{StaticResource MetroAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource MetroPrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,3,0,0"
                                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
