<Page
    x:Class="QQReborn.App.Views.ProfilePlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 大标题头部 -->
        <Grid Grid.Row="0" Margin="24,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="我" FontSize="13" CharacterSpacing="40"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock x:Name="TitleText" Text="" FontSize="36" FontWeight="Light" CharacterSpacing="-20"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="&#x2190;" />
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon x:Name="GlyphText" Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Text="这里什么都没有" FontSize="20" FontWeight="Light" Margin="0,16,0,0"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="HintText" Text="登录后同步" FontSize="13" Margin="0,8,0,0"
                           Foreground="{StaticResource MetroSubtleBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <ListView x:Name="ResourceList" Visibility="Collapsed" Margin="18,0,18,18"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="ResourceList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="64" Margin="0,0,0,8" Background="{StaticResource MetroPanelBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                      Margin="14,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource MetroAccentBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{StaticResource MetroPrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,3,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Margin="10,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
