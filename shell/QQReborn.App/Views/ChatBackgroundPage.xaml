<Page
    x:Class="QQReborn.App.Views.ChatBackgroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="聊天背景" Style="{StaticResource ModernHeaderTitleStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,24">
            <StackPanel Margin="14,12,14,0">
                <TextBlock Text="点击选择一种聊天背景，所有会话立即生效。" FontSize="12" Margin="4,0,0,14"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />

                <TextBlock Text="纯色" Style="{StaticResource MetroSectionLabelStyle}" Margin="4,0,0,10" />
                <GridView x:Name="SolidGrid"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Swatch_ItemClick"
                          Padding="0" Margin="0,0,0,18">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="100">
                                <Border Width="100" Height="140" CornerRadius="12" BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Rectangle Fill="{Binding Preview}" />
                                        <Border BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="2" CornerRadius="12"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Background="{StaticResource MetroAccentBrush}" Width="22" Height="22" CornerRadius="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="12"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock Text="图片" Style="{StaticResource MetroSectionLabelStyle}" Margin="4,0,0,10" />
                <GridView x:Name="ImageGrid"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Swatch_ItemClick"
                          Padding="0" Margin="0,0,0,8">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="100">
                                <Border Width="100" Height="140" CornerRadius="12" BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding ImageSource}" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="2" CornerRadius="12"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Background="{StaticResource MetroAccentBrush}" Width="22" Height="22" CornerRadius="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="12"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
