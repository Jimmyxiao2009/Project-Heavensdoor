<Page
    x:Class="QQReborn.App.Views.ChatBackgroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 大标题头部 -->
        <Grid Grid.Row="0" Margin="24,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="个性化" FontSize="13" CharacterSpacing="40"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock Text="聊天背景" FontSize="36" FontWeight="Light" CharacterSpacing="-20"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="&#x2190;" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,24">
            <StackPanel Margin="20,8,20,0">
                <TextBlock Text="点击选择一种聊天背景，所有会话立即生效。" FontSize="12" Margin="2,0,0,14"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />

                <!-- 纯色 -->
                <TextBlock Text="纯色" FontSize="14" CharacterSpacing="40" Margin="2,0,0,10"
                           Foreground="{StaticResource MetroAccentBrush}" />
                <GridView x:Name="SolidGrid"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Swatch_ItemClick"
                          Padding="0" Margin="0,0,0,20">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="100">
                                <Grid Width="100" Height="140">
                                    <!-- color preview -->
                                    <Rectangle Width="100" Height="140" Fill="{Binding Preview}" />
                                    <!-- selection border -->
                                    <Border BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="3"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <!-- check mark -->
                                    <Border Background="{StaticResource MetroAccentBrush}" Width="24" Height="24"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="&#x2713;" FontSize="15" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Light"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 图片 -->
                <TextBlock Text="图片" FontSize="14" CharacterSpacing="40" Margin="2,0,0,10"
                           Foreground="{StaticResource MetroAccentBrush}" />
                <GridView x:Name="ImageGrid"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Swatch_ItemClick"
                          Padding="0" Margin="0,0,0,8">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="100">
                                <Grid Width="100" Height="140">
                                    <!-- image preview -->
                                    <Rectangle Width="100" Height="140">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding ImageSource}" Stretch="UniformToFill" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <!-- selection border -->
                                    <Border BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="3"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <!-- check mark -->
                                    <Border Background="{StaticResource MetroAccentBrush}" Width="24" Height="24"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="&#x2713;" FontSize="15" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Light"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
