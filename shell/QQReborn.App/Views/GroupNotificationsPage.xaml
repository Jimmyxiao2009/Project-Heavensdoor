<Page
    x:Class="QQReborn.App.Views.GroupNotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{StaticResource MetroPanelBrush}" Height="56" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="BackButton_Click"
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource MetroPrimaryTextBrush}"
                    FontSize="20" Padding="8,4" Content="←" />

            <TextBlock Grid.Column="1" Text="群通知 / 加群申请" FontSize="18" FontWeight="SemiLight"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource MetroPrimaryTextBrush}" />
        </Grid>

        <ListView Grid.Row="1" x:Name="NotificationList" Padding="16" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,10" BorderBrush="{StaticResource MetroSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MetroPrimaryTextBrush}" />
                            <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource MetroSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="同意" Click="Accept_Click" Margin="0,0,8,0"
                                    Background="{StaticResource MetroAccentBrush}" Foreground="White" BorderThickness="0" Padding="12,6" />
                            <Button Content="拒绝" Click="Reject_Click"
                                    Background="{StaticResource MetroSubtleBrush}" Foreground="{StaticResource MetroPrimaryTextBrush}" BorderThickness="0" Padding="12,6" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" x:Name="EmptyHint" Text="暂无加群申请或通知" FontSize="16"
                   Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Page>
