<Page
    x:Class="QQReborn.App.Views.GroupNotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="52" Background="{StaticResource MetroChromeBrush}"
              BorderBrush="{StaticResource ModernHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="BackButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                          Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
            <TextBlock Grid.Column="1" Text="群通知" Style="{StaticResource ModernHeaderTitleStyle}" />
        </Grid>

        <ListView Grid.Row="1" x:Name="NotificationList" Padding="12,12" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,8" Padding="12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarCache}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="同意" Click="Accept_Click" Margin="0,0,6,0"
                                        Background="{StaticResource MetroAccentBrush}" Foreground="White"
                                        BorderThickness="0" Padding="12,7" FontSize="12" FontWeight="SemiBold" />
                                <Button Content="拒绝" Click="Reject_Click"
                                        Style="{StaticResource MetroChromeButtonStyle}"
                                        Padding="12,7" FontSize="12" MinWidth="0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock Grid.Row="1" x:Name="EmptyHint" Text="暂无加群申请或通知" FontSize="14"
                   Foreground="{StaticResource MetroSecondaryTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Page>
