<UserControl
    x:Class="QQReborn.App.Views.MomentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    xmlns:mvvm="using:QQReborn.App.Mvvm"
    Background="{StaticResource MetroBackgroundBrush}">

    <UserControl.Resources>
        <mvvm:LikedToBrushConverter x:Key="LikedToBrush" />

        <DataTemplate x:Key="MomentCommentTemplate" x:DataType="models:MomentComment">
            <StackPanel Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Author}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                               Margin="6,0,0,0" Foreground="{StaticResource MetroPrimaryTextBrush}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Replies}" Margin="14,4,0,0"
                              Visibility="{Binding HasReplies, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MomentComment">
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Author}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MetroAccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11"
                                           TextWrapping="Wrap" Margin="5,0,0,0"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MomentItemTemplate" x:DataType="models:Moment">
            <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,10" Padding="14,14"
                    Tapped="MomentCard_Tapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="42" Height="42" VerticalAlignment="Top">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AuthorAvatarPath, Converter={StaticResource AvatarCache}}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AuthorName}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetroPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TimeText}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Text}" FontSize="14" TextWrapping="Wrap"
                               LineHeight="22" Margin="0,12,0,0"
                               Foreground="{StaticResource MetroPrimaryTextBrush}"
                               Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Grid Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="10" Width="220" Height="220" HorizontalAlignment="Left"
                                    Visibility="{Binding IsSingleImage, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding SingleImagePath}" Stretch="UniformToFill"
                                       Tag="{Binding SingleImagePath}" Tapped="MomentImage_Tapped" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding ImagePaths}"
                                          Visibility="{Binding IsMultiImage, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="92" Height="92" CornerRadius="8" Margin="0,0,6,0"
                                                Tag="{Binding}" Tapped="MomentImage_Tapped">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Border Width="240" Height="150" CornerRadius="12" Margin="0,8,0,0" HorizontalAlignment="Left"
                              Background="#FF000000" Tag="{Binding VideoPath}" Tapped="VideoPoster_Tapped"
                              Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <TextBlock Text="▶" FontSize="36" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="点击播放视频" FontSize="11"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,24,0"
                                Click="LikeButton_Click" Tag="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE734;" FontSize="16" VerticalAlignment="Center"
                                          Foreground="{Binding IsLiked, Converter={StaticResource LikedToBrush}}" />
                                <TextBlock Text="{Binding LikeText}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding IsLiked, Converter={StaticResource LikedToBrush}}" />
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Click="CommentButton_Click" Tag="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BD;" FontSize="14" VerticalAlignment="Center"
                                          Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                <TextBlock Text="{Binding CommentCountText}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,10,0,0" FontSize="12"
                               Text="{Binding LikersText}"
                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasLikers, Converter={StaticResource BoolToVisibility}}" />

                    <Border Grid.Row="5" Background="{StaticResource ModernElevatedBrush}" CornerRadius="10"
                            Margin="0,12,0,0" Padding="12,10"
                            Visibility="{Binding HasComments, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Comments}" ItemTemplate="{StaticResource MomentCommentTemplate}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="12,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="48" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="QQ空间" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                <TextBlock Text="真实动态" FontSize="11" Margin="0,2,0,0"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="SyncText" Text="等待同步" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
            <Button Grid.Column="2" x:Name="RefreshButton" Click="RefreshButton_Click"
                    Style="{StaticResource ModernIconButtonStyle}" Padding="8"
                    ToolTipService.ToolTip="刷新空间动态">
                <SymbolIcon Symbol="Refresh" Foreground="{StaticResource MetroPrimaryTextBrush}" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="8,6" Margin="0,0,0,10"
                Visibility="{Binding IsPublishSupported, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="PublishBox" PlaceholderText="这一刻的想法…"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource MetroPrimaryTextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" FontSize="18" Click="PickImages_Click"
                            Style="{StaticResource ModernIconButtonStyle}" Padding="8" MinWidth="40" MinHeight="40">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B9;"
                                  Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </Button>
                    <Button Grid.Column="2" FontSize="18" Click="PickVideo_Click"
                            Style="{StaticResource ModernIconButtonStyle}" Padding="8" MinWidth="40" MinHeight="40">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B2;"
                                  Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </Button>
                    <Button Grid.Column="3" Content="发表" Click="PublishButton_Click"
                            Background="{StaticResource MetroAccentBrush}" Foreground="White"
                            BorderThickness="0" Margin="4,0,0,0" Padding="14,8" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="AttachPreview" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <ListView Grid.Row="2" x:Name="FeedList"
                  ItemsSource="{Binding Feed}"
                  ItemTemplate="{StaticResource MomentItemTemplate}"
                  SelectionMode="None"
                  Padding="0,0,0,12"
                  Visibility="{Binding IsSupported, Converter={StaticResource BoolToVisibility}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmptyFeed, Converter={StaticResource BoolToVisibility}}">
            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource ModernElevatedBrush}"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
                <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                          Foreground="{StaticResource MetroSecondaryTextBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="还没有空间动态" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource MetroPrimaryTextBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="登录 QQ 后自动拉取好友动态" FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <Button Grid.Row="3" x:Name="LoadMoreButton" Content="加载更多历史动态" Click="LoadMore_Click"
                HorizontalAlignment="Center" Margin="0,8,0,16"
                Padding="22,10" FontSize="13" FontWeight="SemiBold"
                Style="{StaticResource MetroChromeButtonStyle}"
                Foreground="{StaticResource MetroAccentBrush}"
                Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
