<Page
    x:Class="QQReborn.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    xmlns:views="using:QQReborn.App.Views"
    Background="{StaticResource MetroBackgroundBrush}">

    <Page.BottomAppBar>
        <CommandBar Style="{StaticResource MetroCommandBarStyle}"
                    OverflowButtonVisibility="Visible">
            <AppBarButton Style="{StaticResource MetroAppBarButtonStyle}"
                          Icon="Find" Label="搜索" Click="SearchAppBar_Click" />
            <AppBarButton Style="{StaticResource MetroAppBarButtonStyle}"
                          Icon="Add" Label="添加" Click="AddMenu_Click" />
            <AppBarButton Style="{StaticResource MetroAppBarButtonStyle}"
                          Icon="Refresh" Label="刷新" Click="RefreshAppBar_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="全部已读" Click="MarkAllRead_Click" />
                <AppBarButton Label="全部免打扰" Click="MuteAll_Click" />
                <AppBarButton Label="恢复通知" Click="UnmuteAll_Click" />
                <AppBarButton Label="文件" Click="Files_Click" />
                <AppBarButton Label="快捷面板" Click="QuickPanelAppBar_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Page.Resources>
        <CollectionViewSource x:Key="ContactGroupsView"
                              Source="{Binding ContactGroups}"
                              IsSourceGrouped="True" />

        <Style x:Key="ContactAlphabetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MetroAccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Conversation row — square avatar, Metro list rhythm -->
        <DataTemplate x:Key="ConversationItemTemplate" x:DataType="models:ChatConversation">
            <Grid Height="80" Margin="0,0,19,0"
                  Background="{Binding IsPinned, Converter={StaticResource PinnedRowBrush}}"
                  Holding="Conversation_Holding" RightTapped="Conversation_RightTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Rectangle Width="58" Height="58">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border Background="{StaticResource MetroAccentBrush}" MinWidth="20" Height="20"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" Padding="5,0"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Background="#99000000"
                                    Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiLight"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PreviewDisplay}" FontSize="13"
                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastTimeText}" FontSize="12"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Right" />
                    <FontIcon Glyph="&#xE74F;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                              HorizontalAlignment="Right" Margin="0,6,0,0"
                              Foreground="{StaticResource MetroSecondaryTextBrush}"
                              Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Contact row -->
        <DataTemplate x:Key="ContactItemTemplate" x:DataType="models:Contact">
            <Grid Height="72" Margin="0,0,19,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Rectangle Width="52" Height="52">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-2,-2" Fill="{StaticResource MetroAccentBrush}"
                               Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiLight"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Signature}" FontSize="12"
                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Main surface: scales slightly when quick panel is open (WP depth cue) -->
        <Grid x:Name="PageContent" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <CompositeTransform />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Panorama chrome: app name + giant title (tap / pull for shortcuts) -->
            <Grid Grid.Row="0" Padding="19,10,12,0"
                  ManipulationMode="TranslateY"
                  ManipulationDelta="Header_ManipulationDelta"
                  ManipulationCompleted="Header_ManipulationCompleted">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="TitleButton" Grid.Row="0" Grid.RowSpan="2"
                        Click="Title_Click"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ManipulationMode="None"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                        VerticalAlignment="Top" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="QQ REBORN" Style="{StaticResource MetroPageTitleStyle}" />
                        <TextBlock Text="qq" Style="{StaticResource MetroPanoramaTitleStyle}" Margin="0,-4,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Pivot sections — classic WP horizontal sections with peeking headers -->
            <Pivot x:Name="MainPivot" Grid.Row="1"
                   Style="{StaticResource MetroPivotStyle}"
                   Margin="19,4,0,0">

                <PivotItem Header="消息" Style="{StaticResource MetroPivotItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource MetroSearchBarStyle}" Tapped="SearchBar_Tapped">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                <TextBlock Text="搜索" FontSize="15" FontWeight="Light" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        <ListView Grid.Row="1" x:Name="ConversationList"
                                  ItemsSource="{Binding Conversations}"
                                  ItemTemplate="{StaticResource ConversationItemTemplate}"
                                  Style="{StaticResource MetroListStyle}"
                                  ItemClick="ConversationList_ItemClick" />
                    </Grid>
                </PivotItem>

                <PivotItem Header="联系人" Style="{StaticResource MetroPivotItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource MetroSectionSurfaceStyle}" Margin="0,0,19,12">
                            <StackPanel>
                                <Grid Height="72" Background="Transparent" Tapped="NewFriends_Tapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center"
                                            Background="{StaticResource MetroAccentBrush}">
                                        <FontIcon Glyph="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="新朋友" FontSize="19" FontWeight="SemiLight"
                                               VerticalAlignment="Center" Margin="14,0,0,0"
                                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="22" VerticalAlignment="Center"
                                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource MetroSubtleBrush}" Margin="14,0" />
                                <Grid Height="72" Background="Transparent" Tapped="GroupNotifications_Tapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center"
                                            Background="{StaticResource MetroChromeBrush}">
                                        <FontIcon Glyph="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="群通知" FontSize="19" FontWeight="SemiLight"
                                               VerticalAlignment="Center" Margin="14,0,0,0"
                                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="22" VerticalAlignment="Center"
                                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <ListView Grid.Column="0" x:Name="ContactList"
                                      ItemsSource="{Binding Source={StaticResource ContactGroupsView}}"
                                      ItemTemplate="{StaticResource ContactItemTemplate}"
                                      Style="{StaticResource MetroListStyle}"
                                      ItemClick="ContactList_ItemClick">
                                <ListView.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Key}" FontSize="16" FontWeight="SemiLight"
                                                           Margin="0,14,19,4"
                                                           Foreground="{StaticResource MetroAccentBrush}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListView.GroupStyle>
                            </ListView>

                            <!-- Start-menu style quick index. Disabled letters remain visible so
                                 the alphabet keeps a stable position while contacts load. -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center">
                                <StackPanel x:Name="ContactAlphabetBar" HorizontalAlignment="Center">
                                    <Button Content="#" Tag="#" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="A" Tag="A" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="B" Tag="B" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="C" Tag="C" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="D" Tag="D" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="E" Tag="E" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="F" Tag="F" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="G" Tag="G" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="H" Tag="H" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="I" Tag="I" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="J" Tag="J" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="K" Tag="K" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="L" Tag="L" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="M" Tag="M" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="N" Tag="N" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="O" Tag="O" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="P" Tag="P" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="Q" Tag="Q" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="R" Tag="R" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="S" Tag="S" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="T" Tag="T" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="U" Tag="U" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="V" Tag="V" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="W" Tag="W" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="X" Tag="X" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="Y" Tag="Y" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                    <Button Content="Z" Tag="Z" Style="{StaticResource ContactAlphabetButtonStyle}"
                                            Click="ContactAlphabet_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </PivotItem>

                <PivotItem Header="动态" Style="{StaticResource MetroPivotItemStyle}">
                    <views:MomentsView />
                </PivotItem>

                <PivotItem Header="我" Style="{StaticResource MetroPivotItemStyle}">
                    <views:ProfileView />
                </PivotItem>
            </Pivot>
        </Grid>

        <!-- Dimmer when quick panel is open -->
        <Border x:Name="QuickDimmer" Background="#99000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsHitTestVisible="True" Visibility="Collapsed"
                Tapped="QuickDimmer_Tapped" PointerPressed="QuickDimmer_PointerPressed" />

        <!-- Drop-down Metro tiles (classic WP quick actions) -->
        <Border x:Name="QuickPanel"
                VerticalAlignment="Top" Height="280" Margin="12,0,12,0"
                Background="{StaticResource MetroChromeBrush}"
                RenderTransformOrigin="0.5,0" Visibility="Collapsed"
                Tapped="QuickPanel_Tapped" PointerPressed="QuickPanel_PointerPressed">
            <Border.RenderTransform>
                <CompositeTransform TranslateY="-280" />
            </Border.RenderTransform>
            <Grid Padding="14,16,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="2,0,2,12">
                    <TextBlock Text="快捷" FontSize="13" CharacterSpacing="40"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    <TextBlock Text="控制中心" FontSize="28" FontWeight="Light" CharacterSpacing="-10"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Margin="0,0,6,6"
                            Style="{StaticResource MetroTileButtonStyle}"
                            Content="全部已读" Click="MarkAllRead_Click" />
                    <Button Grid.Row="0" Grid.Column="1" Margin="6,0,0,6"
                            Style="{StaticResource MetroTileSecondaryButtonStyle}"
                            Content="全部免打扰" Click="MuteAll_Click" />
                    <Button Grid.Row="1" Grid.Column="0" Margin="0,6,6,0"
                            Style="{StaticResource MetroTileSecondaryButtonStyle}"
                            Content="恢复通知" Click="UnmuteAll_Click" />
                    <Button Grid.Row="1" Grid.Column="1" Margin="6,6,0,0"
                            Style="{StaticResource MetroTileButtonStyle}"
                            Background="{StaticResource MetroAccentDarkBrush}"
                            Content="文件" Click="Files_Click" />
                </Grid>
            </Grid>
        </Border>

        <views:InAppBanner x:Name="Banner" VerticalAlignment="Top" />
    </Grid>
</Page>
