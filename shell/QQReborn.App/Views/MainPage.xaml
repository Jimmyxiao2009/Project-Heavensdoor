<Page
    x:Class="QQReborn.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    xmlns:views="using:QQReborn.App.Views"
    Background="{StaticResource MetroBackgroundBrush}">

    <Page.Resources>
        <CollectionViewSource x:Key="ContactGroupsView"
                              Source="{Binding ContactGroups}"
                              IsSourceGrouped="True" />

        <Style x:Key="ContactAlphabetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MetroSecondaryTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="ConversationItemTemplate" x:DataType="models:ChatConversation">
            <Grid Height="{Binding ConversationRowHeight, Source={StaticResource UiScale}}"
                  Padding="14,0,14,0"
                  Background="{Binding IsPinned, Converter={StaticResource PinnedRowBrush}}"
                  Holding="Conversation_Holding" RightTapped="Conversation_RightTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,2,0">
                    <Ellipse Width="{Binding ConversationAvatar, Source={StaticResource UiScale}}"
                             Height="{Binding ConversationAvatar, Source={StaticResource UiScale}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarCache}}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border Background="{StaticResource MetroAccentBrush}" MinWidth="18" Height="18"
                            CornerRadius="9"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" Padding="5,0"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="{Binding UnreadText}" Foreground="White" FontWeight="SemiBold"
                                       FontSize="{Binding UnreadBadge, Source={StaticResource UiScale}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Background="#99000000" CornerRadius="9"
                                    Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               FontSize="{Binding ListTitle, Source={StaticResource UiScale}}"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PreviewDisplay}"
                               FontSize="{Binding ListPreview, Source={StaticResource UiScale}}"
                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,12,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastTimeText}"
                               FontSize="{Binding ListTime, Source={StaticResource UiScale}}"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" HorizontalAlignment="Right" />
                    <FontIcon Glyph="&#xE74F;" FontFamily="Segoe MDL2 Assets"
                              FontSize="{Binding ListTime, Source={StaticResource UiScale}}"
                              HorizontalAlignment="Right" Margin="0,8,0,0"
                              Foreground="{StaticResource MetroSecondaryTextBrush}"
                              Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ContactItemTemplate" x:DataType="models:Contact">
            <Grid Height="{Binding ContactRowHeight, Source={StaticResource UiScale}}" Padding="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse Width="{Binding ContactAvatar, Source={StaticResource UiScale}}"
                             Height="{Binding ContactAvatar, Source={StaticResource UiScale}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarCache}}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,0,0" Fill="{StaticResource ModernSuccessBrush}"
                             Stroke="{StaticResource MetroBackgroundBrush}" StrokeThickness="2"
                             Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               FontSize="{Binding ListTitle, Source={StaticResource UiScale}}"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Signature}"
                               FontSize="{Binding ListPreview, Source={StaticResource UiScale}}"
                               Foreground="{StaticResource MetroSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Chats -->
        <Grid x:Name="ChatsPanel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ModernSearchBarStyle}" Tapped="SearchBar_Tapped" Margin="12,10,12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    <TextBlock Text="搜索会话与联系人" FontSize="14" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                </StackPanel>
            </Border>
            <ListView Grid.Row="1" x:Name="ConversationList"
                      ItemsSource="{Binding Conversations}"
                      ItemTemplate="{StaticResource ConversationItemTemplate}"
                      Style="{StaticResource ModernListStyle}"
                      ItemClick="ConversationList_ItemClick" />
            <views:InAppBanner x:Name="Banner" Grid.Row="0" Grid.RowSpan="2"
                               VerticalAlignment="Top" Margin="12,58,12,0" />
        </Grid>

        <!-- Contacts -->
        <Grid x:Name="ContactsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Margin="12,10,12,8" Padding="6,4">
                <StackPanel>
                    <Grid Height="56" Background="Transparent" Tapped="NewFriends_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                Background="{StaticResource MetroAccentBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="新朋友" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="12" VerticalAlignment="Center"
                                  Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource ModernHairlineBrush}" Margin="52,0,4,0" />
                    <Grid Height="56" Background="Transparent" Tapped="GroupNotifications_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                Background="{StaticResource ModernElevatedBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="群通知" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="12" VerticalAlignment="Center"
                                  Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ListView Grid.Column="0" x:Name="ContactList"
                          ItemsSource="{Binding Source={StaticResource ContactGroupsView}}"
                          ItemTemplate="{StaticResource ContactItemTemplate}"
                          Style="{StaticResource ModernListStyle}"
                          ItemClick="ContactList_ItemClick">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key}" FontSize="12" FontWeight="SemiBold"
                                               Margin="16,14,16,4"
                                               Foreground="{StaticResource MetroAccentBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel x:Name="ContactAlphabetBar" HorizontalAlignment="Center">
                        <Button Content="#" Tag="#" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="A" Tag="A" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="B" Tag="B" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="C" Tag="C" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="D" Tag="D" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="E" Tag="E" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="F" Tag="F" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="G" Tag="G" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="H" Tag="H" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="I" Tag="I" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="J" Tag="J" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="K" Tag="K" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="L" Tag="L" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="M" Tag="M" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="N" Tag="N" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="O" Tag="O" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="P" Tag="P" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="Q" Tag="Q" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="R" Tag="R" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="S" Tag="S" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="T" Tag="T" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="U" Tag="U" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="V" Tag="V" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="W" Tag="W" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="X" Tag="X" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="Y" Tag="Y" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                        <Button Content="Z" Tag="Z" Style="{StaticResource ContactAlphabetButtonStyle}" Click="ContactAlphabet_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
