<Page
    x:Class="QQReborn.App.Views.VoiceCallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部小标题 + 返回 -->
        <Grid Grid.Row="0" Margin="24,16,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="语音通话" FontSize="13" CharacterSpacing="40"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
            <Button Grid.Column="1" x:Name="BackButton" Click="HangUp_Click" Content="&#x2190;"
                    Background="Transparent" BorderThickness="0" Padding="10,6"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" />
        </Grid>

        <!-- 头像 + 名字 + 状态 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Rectangle Width="148" Height="148" HorizontalAlignment="Center">
                <Rectangle.Fill>
                    <ImageBrush x:Name="PeerAvatarBrush" Stretch="UniformToFill" />
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock x:Name="PeerNameText" Text="对方" FontSize="34" FontWeight="Light"
                       CharacterSpacing="-20" HorizontalAlignment="Center" Margin="0,28,0,0"
                       Foreground="{StaticResource MetroPrimaryTextBrush}" />
            <TextBlock x:Name="StatusText" Text="正在呼叫…" FontSize="16" FontWeight="Light"
                       HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="{StaticResource MetroSecondaryTextBrush}" />
        </StackPanel>

        <!-- 底部控制按钮 -->
        <Grid Grid.Row="2" Margin="0,0,0,56" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 静音 -->
            <StackPanel Grid.Column="0" Margin="22,0">
                <Button x:Name="MuteButton" Click="Mute_Click" Width="72" Height="72" Background="{StaticResource MetroPanelBrush}"
                        BorderThickness="0" Padding="0">
                    <TextBlock x:Name="MuteGlyph" Text="&#x1F3A4;" FontSize="28"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                </Button>
                <TextBlock x:Name="MuteLabel" Text="静音" FontSize="12" HorizontalAlignment="Center"
                           Margin="0,10,0,0" Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>

            <!-- 挂断 (红) -->
            <StackPanel Grid.Column="1" Margin="22,0">
                <Button x:Name="HangUpButton" Click="HangUp_Click" Width="84" Height="84" Background="{StaticResource MetroDangerBrush}"
                        BorderThickness="0" Padding="0">
                    <TextBlock Text="&#x2715;" FontSize="32" Foreground="White" />
                </Button>
                <TextBlock Text="挂断" FontSize="12" HorizontalAlignment="Center"
                           Margin="0,10,0,0" Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>

            <!-- 免提 -->
            <StackPanel Grid.Column="2" Margin="22,0">
                <Button x:Name="SpeakerButton" Click="Speaker_Click" Width="72" Height="72" Background="{StaticResource MetroPanelBrush}"
                        BorderThickness="0" Padding="0">
                    <TextBlock x:Name="SpeakerGlyph" Text="&#x1F50A;" FontSize="28"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                </Button>
                <TextBlock x:Name="SpeakerLabel" Text="免提" FontSize="12" HorizontalAlignment="Center"
                           Margin="0,10,0,0" Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
