<Page
    x:Class="QQReborn.App.Views.VideoCallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MetroBackgroundBrush}">

    <Grid>
        <!-- 本地摄像头预览铺满全屏 -->
        <CaptureElement x:Name="PreviewElement" Stretch="UniformToFill" />

        <!-- 摄像头不可用 / 已关闭视频 时的占位 -->
        <Grid x:Name="NoCameraPanel" Visibility="Collapsed"
              Background="{StaticResource MetroBackgroundBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#x1F4F7;" FontSize="56" HorizontalAlignment="Center"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock x:Name="NoCameraText" Text="摄像头不可用" FontSize="16" FontWeight="Light"
                           HorizontalAlignment="Center" Margin="0,16,0,0"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <!-- 顶部覆盖：对方名字 + 状态/计时；右上角对方头像小窗 -->
        <Grid VerticalAlignment="Top" Margin="24,16,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock x:Name="PeerNameText" Text="对方" FontSize="26" FontWeight="Light"
                           CharacterSpacing="-20"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" />
                <TextBlock x:Name="StatusText" Text="正在呼叫…" FontSize="14" FontWeight="Light"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>
            <!-- 对方“远端视频”占位：用头像代替 -->
            <Border Grid.Column="1" Width="96" Height="128" VerticalAlignment="Top"
                    Background="{StaticResource MetroPanelBrush}">
                <Rectangle Margin="2">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="PeerAvatarBrush" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                </Rectangle>
            </Border>
        </Grid>

        <!-- 底部控制按钮 -->
        <Grid VerticalAlignment="Bottom" Margin="0,0,0,48" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 切换摄像头 -->
            <StackPanel Grid.Column="0" Margin="14,0">
                <Button x:Name="SwitchButton" Click="Switch_Click" Width="64" Height="64" Background="{StaticResource MetroPanelBrush}"
                        BorderThickness="0" Padding="0">
                    <TextBlock Text="&#x1F504;" FontSize="26"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                </Button>
                <TextBlock Text="切换" FontSize="12" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>

            <!-- 关闭视频 -->
            <StackPanel Grid.Column="1" Margin="14,0">
                <Button x:Name="VideoButton" Click="ToggleVideo_Click" Width="64" Height="64" Background="{StaticResource MetroPanelBrush}"
                        BorderThickness="0" Padding="0">
                    <TextBlock x:Name="VideoGlyph" Text="&#x1F4F7;" FontSize="26"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                </Button>
                <TextBlock x:Name="VideoLabel" Text="关闭视频" FontSize="12" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>

            <!-- 静音 -->
            <StackPanel Grid.Column="2" Margin="14,0">
                <Button x:Name="MuteButton" Click="Mute_Click" Width="64" Height="64" Background="{StaticResource MetroPanelBrush}"
                        BorderThickness="0" Padding="0">
                    <TextBlock x:Name="MuteGlyph" Text="&#x1F3A4;" FontSize="26"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                </Button>
                <TextBlock x:Name="MuteLabel" Text="静音" FontSize="12" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>

            <!-- 挂断 (红) -->
            <StackPanel Grid.Column="3" Margin="14,0">
                <Button x:Name="HangUpButton" Click="HangUp_Click" Width="76" Height="76" Background="{StaticResource MetroDangerBrush}"
                        BorderThickness="0" Padding="0">
                    <TextBlock Text="&#x2715;" FontSize="30" Foreground="White" />
                </Button>
                <TextBlock Text="挂断" FontSize="12" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Foreground="{StaticResource MetroSecondaryTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
