<Page
    x:Class="QQReborn.App.Views.GroupInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQReborn.App.Models"
    xmlns:mvvm="using:QQReborn.App.Mvvm"
    Background="{StaticResource MetroBackgroundBrush}">

    <Page.Resources>
        <mvvm:RoleToBrushConverter x:Key="RoleToBrush" />

        <!-- 群成员格子 -->
        <DataTemplate x:Key="GroupMemberTemplate" x:DataType="models:GroupMember">
            <StackPanel Width="64" Margin="0,0,8,16">
                <Grid Width="52" Height="52" HorizontalAlignment="Center">
                    <Rectangle Width="52" Height="52">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="{StaticResource MetroBackgroundBrush}"
                            Padding="3,0"
                            Visibility="{Binding HasRole, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Role}" FontSize="9"
                                   Foreground="{Binding Role, Converter={StaticResource RoleToBrush}}" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Light"
                           Foreground="{StaticResource MetroSecondaryTextBrush}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,5,0,0" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 大标题头部 -->
        <Grid Grid.Row="0" Margin="24,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="群" FontSize="13" CharacterSpacing="40"
                           Foreground="{StaticResource MetroSecondaryTextBrush}" />
                <TextBlock Text="群聊信息" FontSize="36" FontWeight="Light" CharacterSpacing="-20"
                           Foreground="{StaticResource MetroPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BackButton" Click="BackButton_Click" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top" Padding="10,6" Margin="0,4,0,0"
                    Foreground="{StaticResource MetroSecondaryTextBrush}" FontSize="22" Content="&#x2190;" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,24">
            <StackPanel Margin="20,8,20,0">

                <!-- 群头像 + 标题 + 人数 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Rectangle Width="64" Height="64">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="GroupAvatar" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="GroupTitle" FontSize="22" FontWeight="SemiLight"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MemberCountText" FontSize="13" Margin="0,4,0,0"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- 群成员 -->
                <TextBlock Text="群成员" FontSize="14" CharacterSpacing="40" Margin="0,0,0,10"
                           Foreground="{StaticResource MetroAccentBrush}" />
                <GridView x:Name="MemberGrid"
                          ItemTemplate="{StaticResource GroupMemberTemplate}"
                          SelectionMode="None" IsItemClickEnabled="False"
                          Padding="0" Margin="0,0,0,18">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <!-- 群公告 -->
                <Border Background="{StaticResource MetroPanelBrush}" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="群公告" FontSize="14"
                                   Foreground="{StaticResource MetroPrimaryTextBrush}" />
                        <TextBlock x:Name="AnnouncementText" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- 群名称 -->
                <Grid Background="{StaticResource MetroPanelBrush}" Padding="14,14" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="群名称" FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource MetroPrimaryTextBrush}" />
                    <TextBlock Grid.Column="1" x:Name="GroupNameValue" FontSize="14" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="12,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                    <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="18" VerticalAlignment="Center"
                               Foreground="{StaticResource MetroSecondaryTextBrush}" />
                </Grid>

                <!-- 退出群聊 -->
                <Button x:Name="LeaveButton" Click="LeaveButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource MetroPanelBrush}"
                        Foreground="{StaticResource MetroDangerBrush}"
                        BorderThickness="0" Padding="0,14" FontSize="15"
                        Content="退出群聊" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
