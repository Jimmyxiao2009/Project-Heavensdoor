<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- P3: validate QR login against LagrangeV2 (the maintained successor).
             v1 _ref/Lagrange.Core is ARCHIVED + its public sign URL is dead -> do NOT use it. -->
        <ProjectReference Include="..\LagrangeV2\Lagrange.Core\Lagrange.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.0.6" />
    </ItemGroup>

    <ItemGroup>
        <!-- keep the example next to the build so it's easy to copy -->
        <None Update="signer.config.example.json" CopyToOutputDirectory="PreserveNewest" />
        <None Update="signer.config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('signer.config.json')" />
    </ItemGroup>

</Project>
